{
    "spi-nor": { // Device, The name should be the same with string in image:info:media:type
        "size": "16m", // Size of SPI NOR
        "partitions": {
            "spl":        { "size": "512k" },
            "env":        { "size": "128k" },
            "env_r":      { "size": "128k" },
            "userid":     { "size": "256k" }, // at least 16KB
            "os":         { "size": "3m" },
            "rodata":     { "size": "10m" },
            "data":       { "size": "1m" }
        }
    },
    "image": {
        "info": { // Header information about image
            "platform": "d12x",
            "product": "demo68-nor",
            "version": "1.0.0",
            "media": {
                "type": "spi-nor",
                "device_id": 0
            }
        },
        "updater": { // Image writer which is downloaded to RAM by USB/UART
            "psram": {
                "file": "uartupg-psram-init.aic",
                "attr": ["required", "run"],
                "ram": "0x30043000"
            },
            "spl": {
                "file": "bootloader.aic",
                "attr": ["required", "run"],
                "ram": "0x40100000"
            }
        },
        "target": { // Image components which will be burn to device's partitions
            "spl": {
                "file": "bootloader.aic",
                "attr": ["mtd", "required"],
                "part": ["spl"]
            },
            "env": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env"]
            },
            "env_r": {
                "file": "env.bin",
                "attr": ["mtd", "optional"],
                "part": ["env_r"]
            },
            "os": {
                "file": "d12x_os.itb",
                "attr": ["mtd", "required"],
                "part": ["os"]
            },
            "rodata": {
                "file": "rodata.fatfs",
                "attr": ["mtd", "optional"],
                "part": ["rodata"]
            },
            "data": {
                "file": "data.lfs",
                "attr": ["mtd", "optional"],
                "part": ["data"]
            }
        }
    },
    "pre-process": { // Pre-proccess to generate image components from raw data
	// "spienctool": {
	//     "spl_chacha20_key_encrypted.bin": {
	// 	    "operation": "enckey",
	// 	    "seedver": "1",
	// 	    "spienckey": "keys/spi_enc_key.bin",
	// 	    "file": "keys/spl_chacha20_key.bin"
	//     },
	//     "app_chacha20_key_encrypted.bin": {
	// 	    "operation": "enckey",
	// 	    "seedver": "1",
	// 	    "spienckey": "keys/spi_enc_key.bin",
	// 	    "file": "keys/app_chacha20_key.bin"
	//     },
	// },
        "aicprivate": { // Create aic boot image private data
            "pbp_cfg.bin": {
                "cfg": ["pbp_cfg.json", "partition.json",
			// "pbp_security.json"
		]
            },
            // "spl_cfg.bin": {
            //     "cfg": ["spl_security.json"],
            // },
        },
        "aicimage": { // Create aic boot image
            "uartupg-psram-init.aic": { // No loader, only PreBootProgram to initialize PSRAM
                "head_ver": "0x00010001",
                "resource": {
                    "private": "pbp_cfg.bin",
                    "pbp": "d12x.pbp"
                }
            },
            "pbp_ext.aic": {
                "head_ver": "0x00010001",
                "resource": {
                    "pbp": "d12x.pbp",
                    "private": "pbp_cfg.bin"
                },
                // combine to use with loader.aic
                "with_ext": "true"
            },
            "loader.aic": {
                "head_ver": "0x00010001",
                "loader": {
                    "file": "bootloader.bin",
                    "load address": "0x406c0000",
                    "entry point": "0x406c0100", // 256 byte aic header
                },
                "resource": {
                    // "private": "spl_cfg.bin",  // For security
                    "private": "pbp_cfg.bin"
                },
                // "encryption": { // Encrypt bootloader.bin
                //     "algo": "chacha20",
                //     "key": "keys/spl_chacha20_key.bin",
                // },
            }
        },
        "concatenate": { // cat files in order
            "bootloader.aic": ["pbp_ext.aic", "loader.aic"]
        },
        "elf2itb": { // Create itb image from elf
            "d12x_os.itb": {
                "elf": "d12x.elf",
                "hash": ["crc32"],
                // "encryption": { // Encrypt APP
                //     "algo": "chacha20",
                //     "key": "keys/app_chacha20_key.bin",
                // }
            }
        },
        "uboot_env": {
            "env.bin": {
                "file": "env.txt",
                "size": "4096",
                "redundant": "enable"
            }
        }
    }
}
