from building import *

cwd = GetCurrentDir()
group = []
src = Glob('*.c')
src += Glob('lvgl_screens/*.c')
src += Glob('blit_effects/*.c')
CPPPATH = [cwd, cwd + '/lvgl_screens', cwd + '/blit_effects']

if GetDepend(['LVGL_STORAGE_PATH']):
    ins_dst = GetDepend('LVGL_STORAGE_PATH').strip('"/')
else:
    ins_dst = 'rodata/lvgl_data'

ins_src = 'assets/'
install = [(ins_src, ins_dst)]

group = group + DefineGroup('LVGL-port', src, depend = ['AIC_LVGL_FIVE_DISP_DEMO'], CPPPATH = CPPPATH,
        INSTALL = install)

Return('group')
